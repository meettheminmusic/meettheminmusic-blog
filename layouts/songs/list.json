{{- $result := slice -}}
{{- range (where .Pages "Params.unlisted" "ne" true).ByTitle -}}
  {{- $item := dict "title" .Title "url" .Permalink "tonal_concepts" .Params.tonal_concepts "rhythmic_concepts" .Params.rhythmic_concepts "activity_types" .Params.activity_types "language_origins" .Params.language_origins "social_concepts" .Params.social_concepts "movement_concepts" .Params.movement_concepts "supports_adaptations" .Params.supports_adaptations "modes" .Params.modes "meters" .Params.meters "keys" .Params.keys -}}
  {{- $result = $result | append $item -}}
{{- end -}}
{{ $result | jsonify }}
